{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reisguilherme/homelab-platform/contracts/v1/catalog.schema.json",
  "title": "Homelab consumer catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "services"],
  "properties": {
    "apiVersion": {"const": "homelab/v1"},
    "services": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "commit", "contractPath", "manifestPaths", "status"],
        "properties": {
          "id": {"type": "string", "maxLength": 63, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"},
          "repository": {"type": "string", "maxLength": 256, "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*(?![\\s\\S])"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])"},
          "contractPath": {"$ref": "#/$defs/relativePath"},
          "manifestPaths": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
          "status": {"enum": ["proposed", "deployed"]}
        }
      }
    }
  },
  "$defs": {
    "relativePath": {"type": "string", "maxLength": 256, "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?![\\s\\S])"}
  }
}
