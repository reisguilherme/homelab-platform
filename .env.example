# Copy to a private, untracked .env and replace the credentials before activation.
HOMELAB_GRAFANA_ADMIN_USER=replace-me
HOMELAB_GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-password
HOMELAB_OBSERVABILITY_DIR=/srv/appdata/homelab-observability
# Must already exist; an empty directory enables self-scrape only.
HOMELAB_PROMETHEUS_TARGETS_DIR=/srv/appdata/homelab-observability/targets
HOMELAB_GRAFANA_ROOT_URL=https://127.0.0.1:18443/grafana/

# API and browser must use this exact private HTTPS origin.
PLATFORM_ORIGIN=https://127.0.0.1:18443
GRAFANA_URL=https://127.0.0.1:18443/grafana/
PVE_URL=https://192.0.2.10:8006
PVE_WEB_URL=https://192.0.2.10:8006
# Replace with the complete trusted public PEM, using a multiline single-quoted
# dotenv value. The upstream certificate must also match PVE_URL's hostname/IP.
PVE_CA_PEM='REPLACE_WITH_COMPLETE_TRUSTED_CA_PEM'

# Separate read-only PVE user/token. HomelabMetrics must contain exactly
# Sys.Audit VM.Audit Datastore.Audit, with propagated root ACLs for user + token,
# privsep=1, no user groups and no additional ACLs for that identity.
PVE_METRICS_TOKEN_ID=platform-metrics@pve!collector
PVE_METRICS_TOKEN_SECRET=replace-with-the-read-only-token-secret
HOMELAB_CONTROL_DIR=/srv/appdata/homelab-control
CONTROL_ALLOWED_NODES=node-lab
CONTROL_VM_ID=110
# Replace IDs/dependencies with the reviewed inventory before deployment.
CONTROL_PROTECTED_VMIDS=110,120,121,122
CONTROL_DEPENDENCIES_JSON='{}'
# Empty VMID allowlist intentionally prevents creation until reviewed.
# This profile creates stopped hardware without a NIC or operating system.
CONTROL_PROFILES_JSON='[{"id":"hardware-lab","label":"Hardware: instalar SO e rede depois","node":"node-lab","storage":"local-lvm","volumeGroup":"pve","thinPool":"data","projects":["sandbox"],"vmids":[],"maxCores":2,"maxMemoryMiB":512,"minDiskGiB":4,"maxDiskGiB":4,"reserveStorageGiB":32,"maxCommittedGiB":320}]'
