# Copy to a private, untracked .env and replace the credentials before activation.
HOMELAB_GRAFANA_ADMIN_USER=replace-me
HOMELAB_GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-password
HOMELAB_OBSERVABILITY_DIR=/srv/appdata/homelab-observability
# Must already exist; an empty directory enables self-scrape only.
HOMELAB_PROMETHEUS_TARGETS_DIR=/srv/appdata/homelab-observability/targets
