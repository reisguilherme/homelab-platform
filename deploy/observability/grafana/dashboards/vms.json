    {
      "id": 4,
      "title": "CPU · dentro da VM",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (guest) (rate(node_cpu_seconds_total{job=\"guests\",guest=~\"$guest\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{guest}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sem dados",
