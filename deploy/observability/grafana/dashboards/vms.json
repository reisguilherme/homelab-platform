    {
      "id": 6,
      "title": "RAM livre e cache recuperável",
      "description": "Cache estimado: Cached + Buffers + SReclaimable − Shmem. Não é memória permanentemente ocupada nem aditiva a MemAvailable.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemFree_bytes{job=\"guests\",guest=~\"$guest\"}",
          "legendFormat": "Livre · {{guest}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "clamp_min(node_memory_Cached_bytes{job=\"guests\",guest=~\"$guest\"} + node_memory_Buffers_bytes{job=\"guests\",guest=~\"$guest\"} + node_memory_SReclaimable_bytes{job=\"guests\",guest=~\"$guest\"} - node_memory_Shmem_bytes{job=\"guests\",guest=~\"$guest\"}, 0)",
          "legendFormat": "Cache estimado · {{guest}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
