  "description": "Saúde de playback, lease, TLS, exporters, systemd e alertas. Sem inferência de saúde de mídia a partir de HTTP ou processo.",
  "panels": [
    {
      "id": 90,
      "title": "Aplicações e controle",
      "description": "",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "targets": [],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Este painel acompanha coleta, admissão de playback, TLS e serviços de sistema. Para processos e ações por VM, abra o [portal de controle](https://homelab.greis.dev.br/). Estado de processo não comprova reprodução nem readmissão da automação."
      }
    },
    {
      "id": 23,
      "title": "Jellyfin · acesso admitido",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homeserver_playback_jellyfin_up{job=\"guests\",role=\"playback\"} and on(job,instance) (time() - homeserver_playback_observed_timestamp_seconds{job=\"guests\",role=\"playback\"} <= 60) and on(job,instance) (time() - homeserver_playback_observed_timestamp_seconds{job=\"guests\",role=\"playback\"} >= 0) and on(job,instance) (up{job=\"guests\",role=\"playback\"} == 1)",
          "legendFormat": "{{guest}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponível",
                  "color": "red"
                },
                "1": {
                  "text": "Disponível",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
