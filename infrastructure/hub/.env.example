# Copiar para /opt/homelab-hub/.env no servidor (NUNCA versionar o .env real)
CF_DNS_API_TOKEN=REPLACE_WITH_CLOUDFLARE_DNS_API_TOKEN
K3S_NODE_IP=172.28.64.200
PVE_HOST_IP=192.168.1.20

AUTHELIA_JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
