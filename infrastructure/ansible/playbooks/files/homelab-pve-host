#!/usr/bin/python3
"""Expose firewall state and the measured CPU package power for node_exporter."""
from pathlib import Path
from subprocess import check_output
from time import monotonic, sleep


def package_power():
    for zone in Path("/sys/class/powercap").glob("intel-rapl:[0-9]"):
        if (zone / "name").read_text().strip() != "package-0":
            continue
        energy = zone / "energy_uj"
        limit = int((zone / "max_energy_range_uj").read_text())
        start = int(energy.read_text())
        before = monotonic()
        sleep(1)
        end = int(energy.read_text())
        duration = monotonic() - before
        # Microjoules divided by elapsed seconds gives microwatts.
        return ((end - start) % limit) / 1_000_000 / duration
    return None


status = check_output(["/usr/sbin/pve-firewall", "status"], text=True).strip()
if status not in {f"Status: {state}/{service}" for state in ("enabled", "disabled") for service in ("running", "stopped")}:
    raise ValueError("unrecognized pve-firewall status")
print("# HELP pve_firewall_enabled Whether the Proxmox firewall is enabled and running.")
print("# TYPE pve_firewall_enabled gauge")
print("pve_firewall_enabled", int(status == "Status: enabled/running"))
watts = package_power()
if watts is not None:
    print("# HELP pve_cpu_package_watts Average CPU package power over one second.")
    print("# TYPE pve_cpu_package_watts gauge")
    print(f'pve_cpu_package_watts{{package="0"}} {watts:.6f}')
