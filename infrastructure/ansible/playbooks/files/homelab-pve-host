#!/usr/bin/python3
"""Expose firewall, CPU package power and Gate filesystem metrics."""
import os
from pathlib import Path
import stat
from subprocess import check_output
from time import monotonic, sleep


def package_power():
    for zone in Path("/sys/class/powercap").glob("intel-rapl:[0-9]"):
        if (zone / "name").read_text().strip() != "package-0":
            continue
        energy = zone / "energy_uj"
        limit = int((zone / "max_energy_range_uj").read_text())
        start = int(energy.read_text())
        before = monotonic()
        sleep(1)
        end = int(energy.read_text())
        duration = monotonic() - before
        # Microjoules divided by elapsed seconds gives microwatts.
        return ((end - start) % limit) / 1_000_000 / duration
    return None


def gate_usage():
    device = Path("/dev/disk/by-uuid/58a9af19-1ed0-4488-b08a-c34c35e5ebbf")
    mount = Path("/mnt/gate-4tb")
    try:
        block = device.stat()
    except FileNotFoundError:
        return False, None
    if not stat.S_ISBLK(block.st_mode):
        raise ValueError("Gate UUID does not resolve to a block device")
    if not mount.is_mount():
        return True, None
    # Match the opened filesystem against the disk even if a mount changes mid-scrape.
    fd = os.open(mount, os.O_RDONLY | os.O_DIRECTORY)
    try:
        if os.fstat(fd).st_dev != block.st_rdev:
            return True, None
        return True, os.fstatvfs(fd)
    finally:
        os.close(fd)


def gauge(name, description, value):
    print(f"# HELP {name} {description}")
    print(f"# TYPE {name} gauge")
    print(name, value)


status = check_output(["/usr/sbin/pve-firewall", "status"], text=True).strip()
if status not in {f"Status: {state}/{service}" for state in ("enabled", "disabled") for service in ("running", "stopped")}:
    raise ValueError("unrecognized pve-firewall status")
print("# HELP pve_firewall_enabled Whether the Proxmox firewall is enabled and running.")
print("# TYPE pve_firewall_enabled gauge")
print("pve_firewall_enabled", int(status == "Status: enabled/running"))
watts = package_power()
if watts is not None:
    print("# HELP pve_cpu_package_watts Average CPU package power over one second.")
    print("# TYPE pve_cpu_package_watts gauge")
    print(f'pve_cpu_package_watts{{package="0"}} {watts:.6f}')

present, usage = gate_usage()
gauge("pve_gate4tb_present", "Whether the Gate UUID identifies an attached block device.", int(present))
gauge("pve_gate4tb_mounted", "Whether the Gate filesystem is mounted at its designated path.", int(usage is not None))
if usage is not None:
    gauge("pve_gate4tb_size_bytes", "Size of the mounted Gate filesystem.", usage.f_blocks * usage.f_frsize)
    gauge("pve_gate4tb_avail_bytes", "Free bytes available to non-root users on the Gate filesystem.", usage.f_bavail * usage.f_frsize)
