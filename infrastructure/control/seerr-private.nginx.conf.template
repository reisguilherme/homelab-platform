# Optional private Seerr vhost. Uses the shared private ingress connection map.
server {
    listen @@TAILSCALE_IP@@:443 ssl;
    server_name overseer.greis.dev.br;
    ssl_certificate @@TLS_CERT_PATH@@;
    ssl_certificate_key @@TLS_KEY_PATH@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    if ($ssl_server_name != "overseer.greis.dev.br") { return 421; }
    client_max_body_size 64m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location / {
        proxy_pass http://@@CORE_IP@@:5055;
        proxy_http_version 1.1;
        proxy_set_header Host overseer.greis.dev.br;
        proxy_set_header X-Forwarded-Host overseer.greis.dev.br;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $homelab_private_connection;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }
}
