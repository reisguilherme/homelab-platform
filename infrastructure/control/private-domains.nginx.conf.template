server {
    listen @@TAILSCALE_IP@@:443 ssl;
    server_name jellyfin.greis.dev.br;
    ssl_certificate @@TLS_CERT_PATH@@;
    ssl_certificate_key @@TLS_KEY_PATH@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:HomelabPrivateTLS:1m;
    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    if ($ssl_server_name != "jellyfin.greis.dev.br") { return 421; }
    if ($homelab_jellyfin_reject_legacy) { return 400; }
    client_max_body_size 64m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    proxy_http_version 1.1;
    proxy_set_header Host jellyfin.greis.dev.br;
    proxy_set_header Authorization $homelab_jellyfin_authorization;
    proxy_set_header X-Forwarded-Host jellyfin.greis.dev.br;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $homelab_private_connection;
    proxy_connect_timeout 5s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_request_buffering off;
    proxy_buffering off;
    location = / { return 302 https://jellyfin.greis.dev.br/jellyfin/; }
    location = /jellyfin { return 308 https://jellyfin.greis.dev.br/jellyfin/; }
    location /jellyfin/ {
        # Private application authentication, including native administration.
        proxy_pass http://@@PLAYBACK_IP@@:8096;
    }
    location / { return 404; }
}
