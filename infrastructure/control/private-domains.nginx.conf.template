# Include inside Nginx http {} alongside the existing 8443 site.
# Render offline. The literal Tailscale IP and TLS files must exist before activation.
# Access/error logs are disabled here: request URLs may carry application credentials.
map $http_upgrade $homelab_private_connection {
    default upgrade;
    '' close;
}

# Jellyfin 12.2's web bundle still uses api_key on these two routes. Translate
# only a bounded legacy token when no explicit authentication input is supplied.
# Native legacy authorization stays disabled; the application validates the token.
map $uri $homelab_jellyfin_legacy_path {
    default 0;
    ~^/jellyfin/socket$ 1;
    "~^/jellyfin/Items/(?:[0-9a-fA-F]{32}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})/Download$" 1;
}

map $args $homelab_jellyfin_canonical_key_present {
    default 0;
    "~*(?:^|&)ApiKey(?:=|&|$)" 1;
}

map "$http_authorization|$http_x_emby_authorization|$http_x_emby_token|$http_x_mediabrowser_token|$homelab_jellyfin_canonical_key_present" $homelab_jellyfin_modern_auth_present {
    default 1;
    "||||0" 0;
}

map $args $homelab_jellyfin_legacy_key_present {
    default 0;
    "~*(?:^|&)api_key(?:=|&|$)" 1;
}

map $args $homelab_jellyfin_legacy_key_duplicate {
    default 0;
    "~*(?:^|&)api_key(?:=[^&]*)?(?:&[^&]*)*&api_key(?:=|&|$)" 1;
}

map $arg_api_key $homelab_jellyfin_legacy_key_valid {
    default 0;
    "~^[A-Za-z0-9._~-]{1,4096}$" 1;
}

# Nginx examines raw query names, while Jellyfin decodes them. Refuse encoded
# names only when adapting legacy auth, so they cannot disguise a modern key
# or duplicate token. Encoded values (for example deviceId) remain unchanged.
map $args $homelab_jellyfin_encoded_query_name {
    default 0;
    "~(?:^|&)[^=&]*%[0-9A-Fa-f]{2}[^=&]*(?:=|&|$)" 1;
}

map "$homelab_jellyfin_legacy_path:$homelab_jellyfin_modern_auth_present:$homelab_jellyfin_legacy_key_present" $homelab_jellyfin_legacy_eligible {
    default 0;
    "1:0:1" 1;
}

map "$homelab_jellyfin_legacy_eligible:$homelab_jellyfin_legacy_key_duplicate:$homelab_jellyfin_legacy_key_valid:$homelab_jellyfin_encoded_query_name" $homelab_jellyfin_authorization {
    default $http_authorization;
    "1:0:1:0" 'MediaBrowser Token="$arg_api_key"';
}

map "$homelab_jellyfin_legacy_eligible:$homelab_jellyfin_legacy_key_duplicate:$homelab_jellyfin_legacy_key_valid:$homelab_jellyfin_encoded_query_name" $homelab_jellyfin_reject_legacy {
    default 0;
    "1:0:1:0" 0;
    ~^1: 1;
}

server {
    listen @@TAILSCALE_IP@@:443 ssl default_server;
    server_name _;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_reject_handshake on;
    access_log off;
    error_log /dev/null crit;
    return 444;
}

server {
    listen @@TAILSCALE_IP@@:443 ssl;
    server_name homelab.greis.dev.br;
    ssl_certificate @@TLS_CERT_PATH@@;
    ssl_certificate_key @@TLS_KEY_PATH@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:HomelabPrivateTLS:1m;
    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    if ($ssl_server_name != "homelab.greis.dev.br") { return 421; }
    client_max_body_size 16k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    proxy_http_version 1.1;
    proxy_set_header Host homelab.greis.dev.br;
    proxy_set_header X-Forwarded-Host homelab.greis.dev.br;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;
    location / {
        proxy_pass http://127.0.0.1:8080;
    }
}

